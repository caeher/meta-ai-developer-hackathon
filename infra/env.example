# Configuración exclusiva para Docker Compose local. No reutilizar en producción.
# infra:up copia este archivo a infra/.env si todavía no existe.
POSTGRES_DB=meta_game
POSTGRES_USER=meta_game
POSTGRES_PASSWORD=local-only-postgres-password-change-me-2026
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=meta_game_local
MINIO_ROOT_PASSWORD=local-only-s3-password-change-me-2026
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET_PRIVATE=meta-game-private
S3_BUCKET_PUBLIC=meta-game-public
PUBLISHING_ENABLED=false
PUBLISH_BASE_DOMAIN=games.localhost
PUBLISHING_ORIGIN_PORT=8083
# Solo desarrollo local: producción usa políticas S3 separadas para worker y origen de lectura.
PUBLISH_S3_ACCESS_KEY_ID=meta_game_local
PUBLISH_S3_SECRET_ACCESS_KEY=local-only-s3-password-change-me-2026
PUBLISH_READ_ACCESS_KEY_ID=meta_game_local
PUBLISH_READ_SECRET_ACCESS_KEY=local-only-s3-password-change-me-2026
PUBLISH_READ_DATABASE_URL=postgresql://meta_game:local-only-postgres-password-change-me-2026@postgres:5432/meta_game
SANDBOX_DRIVER=disabled
SANDBOX_HOST_RUNTIME_MODE=rootless
SANDBOX_WORKSPACE_MODE=user-quota
SANDBOX_DOCKER_SOCKET=/run/user/1001/docker.sock
SANDBOX_CONTROLLER_URL=http://sandbox-controller:8081
# Suite de seguridad local: usar solo con el Compose desechable de Docker Desktop.
SECURITY_TEST_ENABLED=false
SECURITY_TEST_DISPOSABLE_HOST=false
PREVIEW_GATEWAY_ENABLED=false
PREVIEW_BASE_DOMAIN=preview.localhost
PREVIEW_TOKEN_KEY_ID=replace-with-active-key-id
PREVIEW_TOKEN_PRIVATE_KEY=replace-with-base64-pkcs8-rsa-private-key
PREVIEW_TOKEN_PUBLIC_KEYS={"replace-with-active-key-id":"replace-with-base64-spki-rsa-public-key"}
PREVIEW_TOKEN_TTL_SECONDS=60
PREVIEW_SESSION_TTL_SECONDS=900
APP_ORIGIN=https://app.localhost
NEXT_PUBLIC_APP_URL=https://app.localhost
AUTH_ALLOWED_ORIGINS=https://app.localhost,http://localhost:3000,http://127.0.0.1:3000
AUTH_SECRET=replace-with-random-32-byte-secret
SESSION_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Forja Local <no-reply@localhost>
META_PRICE_PLAN_INPUT_USD_PER_1M=
META_PRICE_PLAN_OUTPUT_USD_PER_1M=
META_PRICE_CODE_INPUT_USD_PER_1M=
META_PRICE_CODE_OUTPUT_USD_PER_1M=
META_PRICE_IMAGE_USD=
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OBSERVABILITY_PORT=9090
BACKUP_KEY_ID=local-key-v1
BACKUP_ENCRYPTION_KEYS={"local-key-v1":"replace-with-base64-32-byte-key"}
BACKUP_DIR=./backups/encrypted
BACKUP_RETENTION_DAYS=30
