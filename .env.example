# Configuración de la aplicación y autenticación propia.
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SECRET=replace-with-random-32-byte-secret
SESSION_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Forja Local <no-reply@localhost>
# PostgreSQL, Redis y almacenamiento S3 compatible. Drizzle usa DATABASE_URL;
# en local puede derivarse desde infra/.env si no se define en el entorno.
# Los servicios Compose locales usan infra/env.example.
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/meta_game
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=meta-game-private
S3_BUCKET_PUBLIC=meta-game-public
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder
SNAPSHOT_MAX_FILES=512
SNAPSHOT_MAX_FILE_BYTES=8388608
SNAPSHOT_MAX_TOTAL_BYTES=20971520
SNAPSHOT_MAX_ARCHIVE_BYTES=26214400

# Meta Model API: clave privada de operador; nunca usar NEXT_PUBLIC_ ni copiarla al juego.
# El smoke usa un prompt sintético. Contributor puede usar contenido para entrenamiento:
# no enviar información personal, secreta o confidencial.
META_API_KEY=replace-with-operator-provided-key
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_PLAN=muse-spark-1.3-contributor
META_MODEL_CODE=muse-spark-1.3-contributor
META_MODEL_IMAGE=muse-image-1.0
# La salida fuente se limita a 20 MiB; el PNG normalizado a 8 MiB y 2048 px por lado.
# Cada solicitud reserva 1 unidad antes del POST. El precio vigente no se fija en configuración.
# Límite de tiempo por operación HTTP o stream, entre 1000 y 120000 ms.
META_TIMEOUT_MS=60000
# Rates vigentes indicadas por el operador desde la facturación oficial; vacías desactivan la estimación monetaria.
META_PRICE_PLAN_INPUT_USD_PER_1M=
META_PRICE_PLAN_OUTPUT_USD_PER_1M=
META_PRICE_CODE_INPUT_USD_PER_1M=
META_PRICE_CODE_OUTPUT_USD_PER_1M=
META_PRICE_IMAGE_USD=

# Skills de gamedev: catálogo/hash/presupuesto versionados en packages/skills;
# no requieren claves ni variables de entorno.
# La plantilla Phaser tampoco recibe secretos ni configuración de plataforma.

# Controlador sandbox interno de Compose. El worker es el único servicio de
# aplicación que recibe URL/token; solo el controlador accede al runtime Docker.
SANDBOX_CONTROLLER_URL=http://sandbox-controller:8081
SANDBOX_CONTROLLER_TOKEN=placeholder-generate-a-random-token
SANDBOX_DRIVER=disabled
# Suite hostil: ejecutar solo contra el perfil Compose local desechable.
SECURITY_TEST_ENABLED=false
SECURITY_TEST_DISPOSABLE_HOST=false
SANDBOX_IMAGE=registry.example.internal/meta-game/sandbox-node24@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Compose de aceptaciÃ³n sustituye estos valores con Docker Desktop + tmpfs acotado.
SANDBOX_HOST_RUNTIME_MODE=rootless
SANDBOX_WORKSPACE_MODE=user-quota
SANDBOX_CONTROLLER_HOST=127.0.0.1
SANDBOX_CONTROLLER_PORT=8081
SANDBOX_DOCKER_SOCKET=/run/user/1001/docker.sock
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_MB=1024
# Workspace y cuotas se deben comprobar dentro del runtime de Compose antes de activar.
SANDBOX_DISK_MB=2048
SANDBOX_PIDS_LIMIT=128
SANDBOX_COMMAND_TIMEOUT_MS=60000
SANDBOX_IDLE_TTL_SECONDS=900
# El sandbox usa una red Docker interna; solo el proxy de npm puede salir a estos nombres exactos.
SANDBOX_EGRESS_ALLOWLIST=registry.npmjs.org

# API privada de restauración web→worker, solo dentro de la red de servicios.
# Genera un token aleatorio para Compose; no reutilices el del controlador.
WORKER_INTERNAL_URL=http://worker:8082
WORKER_INTERNAL_TOKEN=placeholder-generate-a-separate-random-token
WORKER_INTERNAL_PORT=8082

# Preview privada local. Usa *.localhost y el perfil local-domains de Caddy para
# TLS interno autofirmado. Sin claves RSA válidas el gateway no inicia.
# La clave privada solo vive en la app web; el gateway recibe el mapa público.
# El grant va en cuerpos POST; el fallback para cookies bloqueadas usa un formulario
# de primer nivel y nunca agrega el grant al URL.
PREVIEW_BASE_DOMAIN=preview.localhost
PREVIEW_GATEWAY_ENABLED=false
PREVIEW_TOKEN_KEY_ID=replace-with-active-key-id
PREVIEW_TOKEN_PRIVATE_KEY=replace-with-base64-pkcs8-rsa-private-key
PREVIEW_TOKEN_PUBLIC_KEYS={"replace-with-active-key-id":"replace-with-base64-spki-rsa-public-key"}
PREVIEW_TOKEN_TTL_SECONDS=60
PREVIEW_SESSION_TTL_SECONDS=900
PUBLISH_BASE_DOMAIN=games.localhost
PUBLISHING_ENABLED=false
PUBLISHING_ORIGIN_PORT=8083
# El worker es el único escritor del bucket público de artefactos.
PUBLISH_S3_ACCESS_KEY_ID=replace-with-publication-writer-id
PUBLISH_S3_SECRET_ACCESS_KEY=replace-with-publication-writer-secret
# Solo el origen de publicación necesita lectura del bucket y PostgreSQL read-only.
PUBLISH_READ_ACCESS_KEY_ID=replace-with-publication-reader-id
PUBLISH_READ_SECRET_ACCESS_KEY=replace-with-publication-reader-secret
PUBLISH_READ_DATABASE_URL=postgresql://readonly:replace-with-readonly-password@postgres:5432/meta_game

# Cuotas y operación
# RUNS_ENABLED habilita enqueue y consumo del progreso SSE desde el editor.
# Mantenerlo en false hasta validar Meta, Chromium y el runtime en Compose local.
# Cada run exige messageRequestId y contributorConsent=true desde la UI.
RUNS_ENABLED=false
USER_MAX_CONCURRENT_JOBS=1
USER_MAX_PROJECTS=50
PROJECT_MAX_RUN_STEPS=20
RUN_MAX_TOKENS=32000
RUN_MAX_DURATION_MS=600000
USER_DAILY_TOKEN_LIMIT=100000
# Cada imagen se reserva antes de la solicitud facturable; una respuesta ambigua nunca se reintenta automáticamente.
# El asset y la hoja QA van al bucket privado; la copia Phaser vive solo en el workspace del sandbox.
USER_DAILY_IMAGE_LIMIT=10
USER_MAX_STORAGE_MB=1024
# Mantener apagado hasta probar runtime, cuotas, S3 y controller en Compose local.
RESOURCE_LIFECYCLE_ENABLED=false
PROJECT_DELETION_RETENTION_DAYS=30
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
OBSERVABILITY_PORT=9090

# Backups locales cifrados. Sustituir el placeholder por claves aleatorias de 32 bytes codificadas en Base64.
# BACKUP_ENCRYPTION_KEYS es un mapa JSON por key ID; conservar las claves antiguas hasta vencer los backups asociados.
BACKUP_KEY_ID=local-key-v1
BACKUP_ENCRYPTION_KEYS={"local-key-v1":"replace-with-base64-32-byte-key"}
BACKUP_DIR=./backups/encrypted
BACKUP_RETENTION_DAYS=30
