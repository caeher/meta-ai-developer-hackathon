{
  "name": "meta-ai-game-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/config",
    "packages/contracts",
    "packages/db",
    "packages/meta",
    "packages/sandbox",
    "packages/preview",
    "packages/storage",
    "packages/skills"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "node scripts/check-node-version.mjs && npm run dev --workspace @meta-game/web",
    "build": "node scripts/check-node-version.mjs && npm run build --workspace @meta-game/web",
    "start": "node scripts/check-node-version.mjs && npm run start --workspace @meta-game/web",
    "dev:worker": "node scripts/check-node-version.mjs && npm run dev --workspace @meta-game/worker",
    "build:worker": "node scripts/check-node-version.mjs && npm run build --workspace @meta-game/worker",
    "dev:controller": "node scripts/check-node-version.mjs && npm run dev --workspace @meta-game/sandbox-controller",
    "build:controller": "node scripts/check-node-version.mjs && npm run build --workspace @meta-game/sandbox-controller",
    "dev:gateway": "node scripts/check-node-version.mjs && npm run dev --workspace @meta-game/preview-gateway",
    "build:gateway": "node scripts/check-node-version.mjs && npm run build --workspace @meta-game/preview-gateway",
    "dev:publishing-origin": "node scripts/check-node-version.mjs && npm run dev --workspace @meta-game/publishing-origin",
    "build:publishing-origin": "node scripts/check-node-version.mjs && npm run build --workspace @meta-game/publishing-origin",
    "build:game-template": "node scripts/check-node-version.mjs && npm --prefix packages/game-templates/phaser run build",
    "start:worker": "node scripts/check-node-version.mjs && npm run start --workspace @meta-game/worker",
    "infra:config": "node scripts/check-node-version.mjs && node scripts/infra-config.mjs",
    "infra:up": "node scripts/check-node-version.mjs && node scripts/infra-up.mjs",
    "infra:down": "node scripts/check-node-version.mjs && node scripts/infra-down.mjs",
    "screenshots:theme": "node scripts/check-node-version.mjs && node scripts/capture-theme-screenshots.mjs",
    "test:e2e": "node scripts/check-node-version.mjs && playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:game-templates": "node scripts/check-node-version.mjs && playwright test --config tests/game-templates/playwright.config.ts",
    "test:e2e:server": "node scripts/check-node-version.mjs && vite --config tests/e2e/vite.config.ts",
    "db:migrate": "node scripts/check-node-version.mjs && node scripts/db-migrate.mjs",
    "db:seed": "node scripts/check-node-version.mjs && node scripts/db-seed.mjs",
    "meta:smoke": "node scripts/check-node-version.mjs && node --conditions=react-server --import tsx scripts/meta-smoke.ts",
    "skills:verify": "node scripts/check-node-version.mjs && node --import tsx scripts/verify-skills.ts",
    "sandbox:host-check": "node scripts/check-node-version.mjs && node --import tsx scripts/check-sandbox-host.ts",
    "lint": "node scripts/check-node-version.mjs && eslint apps/web apps/worker apps/sandbox-controller apps/preview-gateway apps/publishing-origin packages/config packages/contracts packages/db packages/meta packages/preview packages/sandbox packages/skills packages/storage packages/game-templates/phaser/src packages/game-templates/phaser/scripts tests scripts --max-warnings=0",
    "typecheck": "node scripts/check-node-version.mjs && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/worker/tsconfig.json && tsc --noEmit -p apps/sandbox-controller/tsconfig.json && tsc --noEmit -p apps/preview-gateway/tsconfig.json && tsc --noEmit -p apps/publishing-origin/tsconfig.json && tsc --noEmit -p packages/config/tsconfig.json && tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p packages/meta/tsconfig.json && tsc --noEmit -p packages/preview/tsconfig.json && tsc --noEmit -p packages/sandbox/tsconfig.json && tsc --noEmit -p packages/skills/tsconfig.json && tsc --noEmit -p packages/storage/tsconfig.json && tsc --noEmit -p packages/game-templates/phaser/tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "node scripts/check-node-version.mjs && vitest run",
    "test:integration": "node scripts/check-node-version.mjs && node scripts/test-integration.mjs",
    "check:node": "node scripts/check-node-version.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.3",
    "@testing-library/react": "16.3.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "jsdom": "26.1.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "phaser": "3.90.0"
  }
}
